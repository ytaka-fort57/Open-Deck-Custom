{
  "$comment": "Open-Deck 自動修正ゲート。初回試験では docs-link だけを許可し、方針・CI・エンジン(node_modules/review-kit とその版を決める package.json / lockfile)は変更不可。",
  "baseBranch": "custom",
  "branchPrefix": "autofix/",
  "maxOpenBranches": 1,
  "excludeCategories": ["security", "persistence"],
  "limits": {
    "maxChangedFiles": 4,
    "maxChangedLines": 100
  },
  "bookkeepingLimits": {
    "maxChangedFiles": 4,
    "maxChangedLines": 120
  },
  "forbiddenPaths": [
    ".env*",
    "package.json",
    "package-lock.json",
    ".github/**",
    ".githooks/**",
    ".agents/skills/backlog/**",
    ".agents/skills/review-*/**",
    ".claude/skills/backlog/**",
    ".claude/skills/review-*/**",
    "docs/dev/automated-review-cycle-runbook.md",
    "manifest.json",
    "manifest_firefox.json",
    "background.js",
    "extensions/custom/storage_repository.js",
    "extensions/custom/safe_values.js",
    "review.config.json",
    "review/**",
    "node_modules/**",
    "tests/review_contract.test.mjs"
  ],
  "classes": {
    "docs-link": {
      "title": "ドキュメントのリンク切れ",
      "scope": ["*.md", "docs/**/*.md", ".claude/**/*.md", ".agents/**/*.md"],
      "check": "docs-links",
      "requireTestChange": false
    }
  }
}
