{
  "name": "Open-Deck",
  "version": "1.1.3.7",
  "manifest_version": 3,
  "description": "The OpenSource Deck",
  "default_locale": "ja",
  "icons" : {
    "128" : "icon.png"
  },
  "host_permissions": [
    "*://*.twitter.com/*",
    "*://*.twimg.com/*",
    "*://*.x.com/*",
    "*://*.kwdev-sys.com/*"
  ],
  "permissions" : ["storage","webRequest","declarativeNetRequest"],
  "background" : {"service_worker" : "background.js"},
  "content_scripts": [
  {
    "matches": ["https://*.twitter.com/*", "https://*.x.com/*"],
    "js": ["extensions/custom/storage_repository.js", "extensions/custom/lifecycle.js", "content.js", "extensions/utils.js", "extensions/text_review.js", "extensions/auto_reload.js", "extensions/media_viewer_block.js", "extensions/media_viewer/media_viewer.js", "extensions/custom/selectors.js", "extensions/custom/column_reorder.js", "extensions/custom/column_history.js", "extensions/custom/keyboard_shortcuts.js", "extensions/custom/column_state.js", "extensions/custom/index.js"]
  }],
  "web_accessible_resources" : [{
    "matches" : ["https://*.twitter.com/*", "https://*.x.com/*"],
    "resources" : [
    "extensions/utils_helper.js",
    "extensions/text_review_helper.js",
    "extensions/auto_reload_helper.js",
    "extensions/media_viewer_block_helper.js",
    "extensions/media_viewer/media_viewer.js",
    "icon.png", 
    "icon/logo_icon.svg",
    "profile_debug.html",
    "extensions/custom/settings_import.html",
    "about_opd.html",
    "icon/settings.svg",
    "icon/banner_hide.svg", 
    "icon/top_hide.svg", 
    "icon/pin.svg", 
    "icon/pinned.svg", 
    "icon/post.svg",
    "icon/text_review.svg",
    "icon/column_move.svg",
    "icon/column_close.svg",
    "icon/column_w_size.svg", 
    "icon/column_add_1st.svg", 
    "icon/column_add_2nd.svg", 
    "icon/tl_column.svg", 
    "icon/notice_column.svg", 
    "icon/exp_column.svg", 
    "icon/single_view.svg", 
    "icon/second_view.svg", 
    "icon/profile_save.svg", 
    "icon/profile_delete.svg",
    "icon/forward.svg",
    "icon/next.svg",
    "icon/download.svg",
    "icon/hashtag_restore.svg"]
  }],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  }
  }