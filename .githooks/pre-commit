#!/bin/sh
# 行末コードの変換を検知してコミットを止める
#
# 本家は改行コードがファイルごとに異なる(content.js は CRLF、manifest_firefox.json は LF)。
# ファイル全体を書き換えるツールは改行コードを変換してしまうことがあり、
# 気付かずコミットすると本家との差分が全面化して取り込み時に衝突する。
#
# 判定は eol-policy.json の正本とのバイト比較で行う。
# diff の行数からの推測ではないため、新規ファイルも末尾改行も検査できる。
# 同じ検査を GitHub Actions (.github/workflows/line-endings.yml) からも呼ぶため、
# このフックを無効化しても CI で同じ規則が適用される。
#
# 有効化(クローンごとに一度だけ必要):
#   git config core.hooksPath .githooks

if ! command -v node >/dev/null 2>&1; then
    echo "node が見つからないため行末検査を実行できません" >&2
    exit 1
fi

node scripts/check-line-endings.mjs --staged || exit 1
node scripts/check-line-endings.mjs --check-editorconfig || exit 1
